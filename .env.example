# ------------------------------------------------------------------------------
# VM Access Anywhere - Environment Configuration Template
# Copy this file to .env and configure strong secrets before starting services.
# ------------------------------------------------------------------------------

# Guacamole Web Client Port Binding (Strictly Localhost)
GUACAMOLE_PORT=127.0.0.1:8080

# PostgreSQL Database Configuration
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_RANDOM_PASSWORD

# Host XRDP Configuration (for guacd bridge)
XRDP_HOST=host.docker.internal
XRDP_PORT=3389

# Cloudflare Zero Trust Configuration
CF_DOMAIN=desktop.intelqong.com
CF_TUNNEL_NAME=vm-access-anywhere
